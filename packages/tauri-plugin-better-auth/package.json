{
  "name": "tauri-plugin-better-auth",
  "version": "0.1.1",
  "description": "Better Auth for Tauri 2: browser sign-in with PKCE, a Rust-held session and a token-free webview.",
  "keywords": [
    "auth",
    "authentication",
    "better-auth",
    "deep-link",
    "desktop",
    "pkce",
    "tauri",
    "tauri-plugin"
  ],
  "homepage": "https://github.com/laakal/tauri-plugin-better-auth#readme",
  "bugs": {
    "url": "https://github.com/laakal/tauri-plugin-better-auth/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laakal/tauri-plugin-better-auth.git",
    "directory": "packages/tauri-plugin-better-auth"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@better-auth/core": "1.7.14",
    "@better-fetch/fetch": "1.3.3",
    "@tauri-apps/api": "2.12.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.14",
    "better-call": "1.4.4",
    "happy-dom": "21.0.4",
    "pg": "8.23.1",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@better-auth/core": ">=1.7.4 <2",
    "@better-fetch/fetch": "^1.3.1",
    "@tauri-apps/api": ">=2.11.0 <3",
    "better-auth": ">=1.7.4 <2",
    "better-call": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
